rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isConversationParticipant() {
      return isSignedIn()
        && resource.data.participantIds is list
        && resource.data.participantIds.hasAny([request.auth.uid]);
    }

    match /users/{userId} {
      allow read, create, update, delete: if isSignedIn()
        && request.auth.uid == userId;
    }

    match /chat_profiles/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid',
          'firstName',
          'lastName',
          'username',
          'email'
        ])
        && request.resource.data.keys().hasAll([
          'uid',
          'firstName',
          'lastName',
          'username',
          'email'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.username is string
        && request.resource.data.email is string;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /chat_rooms/{roomId} {
      allow get: if isSignedIn()
        && (
          !exists(/databases/$(database)/documents/chat_rooms/$(roomId))
          || isConversationParticipant()
        );
      allow list: if isConversationParticipant();

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['participantIds', 'createdAt'])
        && request.resource.data.keys().hasAll(['participantIds', 'createdAt'])
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantIds[0] != request.resource.data.participantIds[1]
        && request.resource.data.participantIds.hasAny([request.auth.uid])
        && (
          roomId == request.resource.data.participantIds[0] + '_'
            + request.resource.data.participantIds[1]
          || roomId == request.resource.data.participantIds[1] + '_'
            + request.resource.data.participantIds[0]
        );

      allow update, delete: if false;

      match /messages/{messageId} {
        function conversationContains(userId) {
          return get(
            /databases/$(database)/documents/chat_rooms/$(roomId)
          ).data.participantIds.hasAny([userId]);
        }

        allow read: if isSignedIn()
          && conversationContains(request.auth.uid);

        allow create: if isSignedIn()
          && request.resource.data.keys().hasOnly([
            'senderId',
            'senderEmail',
            'receiverId',
            'message',
            'timestamp',
            'status'
          ])
          && request.resource.data.keys().hasAll([
            'senderId',
            'senderEmail',
            'receiverId',
            'message',
            'timestamp',
            'status'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderId != request.resource.data.receiverId
          && conversationContains(request.resource.data.senderId)
          && conversationContains(request.resource.data.receiverId)
          && request.resource.data.senderEmail is string
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 4000
          && request.resource.data.timestamp == request.time
          && request.resource.data.status == 'sent';

        allow update: if isSignedIn()
          && resource.data.receiverId == request.auth.uid
          && conversationContains(request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status'])
          && (
            (
              resource.data.status == 'sent'
              && request.resource.data.status in ['delivered', 'seen']
            )
            || (
              resource.data.status == 'delivered'
              && request.resource.data.status == 'seen'
            )
          );

        allow delete: if false;
      }
    }
  }
}
